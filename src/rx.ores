// rx-ores: pull/Future-oriented reactive streams.
//
// This file is a code unit, not an implicit module or package. Consumers choose
// a local namespace with a relative wildcard import and import nominal classes
// explicitly when they want static type names.

pub define class Subscription<T> as
  let bool cancelled = false;
  let bool finished = false;
  let bool pulling = false;
  let bool disposed = false;

  pub next(mut self)(): Option<T> {
    if self.cancelled || self.finished; then
      return None;
    fi
    if self.pulling; then
      val Result<bool, String> failure = Err("only one outstanding next() is allowed");
      failure.expect("rx.Subscription.next");
    fi

    self.pulling = true;
    let bool settled = false;
    try {
      val Option<T> frame = self.pull();
      if frame.is_none(); then
        self.finished = true;
        self.dispose_once();
      fi
      settled = true;
      return frame;
    } finally {
      self.pulling = false;
      if !settled; then
        self.finished = true;
        self.dispose_once();
      fi
    }
  }

  pub pull(mut self)(): Option<T> {
    return None;
  }

  pub dispose(mut self)(): void {
    return;
  }

  // Acquire cleanup before invoking downstream destructors; exceptions must
  // never re-enter dispose or cancel an upstream subscription twice.
  dispose_once(mut self)(): void {
    if self.disposed; then
      return;
    fi
    self.disposed = true;
    self.dispose();
    return;
  }

  pub cancel(mut self)(): bool {
    if self.cancelled || self.finished; then
      return false;
    fi
    self.cancelled = true;
    self.dispose_once();
    return true;
  }
end

pub define class Observable<T> as
  pub subscribe(): Subscription<T> {
    return new Subscription<T>();
  }
end

define class ValuesSubscription<T> extends Subscription<T> as
  val Array<T> values;
  let int cursor = 0;
  val int size;

  constructor(Array<T> values) {
    let int size = 0;
    for const value of values do
      size = size + 1;
    done
    self.values = values;
    self.size = size;
  }

  pub pull(mut self)(): Option<T> {
    if self.cursor >= self.size; then
      return None;
    fi
    val T value = self.values[self.cursor];
    self.cursor = self.cursor + 1;
    return Some(value);
  }
end

define class ValuesObservable<T> extends Observable<T> as
  val Array<T> values;

  constructor(Array<T> values) {
    self.values = values;
  }

  pub subscribe(): Subscription<T> {
    return new ValuesSubscription<T>(self.values);
  }
end

pub fnc from_values<T>(Array<T> values): Observable<T> {
  return new ValuesObservable<T>(values);
}

define class MapSubscription<A, B> extends Subscription<B> as
  val Subscription<A> upstream;
  val Fnc<A, B> transform;

  constructor(Subscription<A> upstream, Fnc<A, B> transform) {
    self.upstream = upstream;
    self.transform = transform;
  }

  pub pull(mut self)(): Option<B> {
    val Option<A> frame = self.upstream.next();
    if frame.is_none(); then
      return None;
    fi
    return Some(self.transform(frame.unwrap()));
  }

  pub dispose(mut self)(): void {
    self.upstream.cancel();
    return;
  }
end

define class FilterSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  val Fnc<T, bool> predicate;

  constructor(Subscription<T> upstream, Fnc<T, bool> predicate) {
    self.upstream = upstream;
    self.predicate = predicate;
  }

  pub pull(mut self)(): Option<T> {
    loop {
      val Option<T> frame = self.upstream.next();
      if frame.is_none(); then
        return None;
      fi
      val T value = frame.unwrap();
      if self.predicate(value); then
        return Some(value);
      fi
    }
  }

  pub dispose(mut self)(): void {
    self.upstream.cancel();
    return;
  }
end

define class TakeSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  let int remaining;

  constructor(Subscription<T> upstream, int count) {
    if count < 0; then
      val Result<bool, String> failure = Err("take count must be nonnegative");
      failure.expect("rx.take");
    fi
    self.upstream = upstream;
    self.remaining = count;
  }

  pub pull(mut self)(): Option<T> {
    if self.remaining == 0; then
      self.upstream.cancel();
      return None;
    fi

    val Option<T> frame = self.upstream.next();
    if frame.is_none(); then
      self.remaining = 0;
      return None;
    fi

    self.remaining = self.remaining - 1;
    if self.remaining == 0; then
      self.upstream.cancel();
    fi
    return frame;
  }

  pub dispose(mut self)(): void {
    self.upstream.cancel();
    return;
  }
end

define class MapObservable<A, B> extends Observable<B> as
  val Observable<A> source;
  val Fnc<A, B> transform;

  constructor(Observable<A> source, Fnc<A, B> transform) {
    self.source = source;
    self.transform = transform;
  }

  pub subscribe(): Subscription<B> {
    return new MapSubscription<A, B>(self.source.subscribe(), self.transform);
  }
end

define class FilterObservable<T> extends Observable<T> as
  val Observable<T> source;
  val Fnc<T, bool> predicate;

  constructor(Observable<T> source, Fnc<T, bool> predicate) {
    self.source = source;
    self.predicate = predicate;
  }

  pub subscribe(): Subscription<T> {
    return new FilterSubscription<T>(self.source.subscribe(), self.predicate);
  }
end

define class TakeObservable<T> extends Observable<T> as
  val Observable<T> source;
  val int count;

  constructor(Observable<T> source, int count) {
    if count < 0; then
      val Result<bool, String> failure = Err("take count must be nonnegative");
      failure.expect("rx.take");
    fi
    self.source = source;
    self.count = count;
  }

  pub subscribe(): Subscription<T> {
    return new TakeSubscription<T>(self.source.subscribe(), self.count);
  }
end

pub fnc map<A, B>(Observable<A> source, Fnc<A, B> transform): Observable<B> {
  return new MapObservable<A, B>(source, transform);
}

pub fnc filter<T>(Observable<T> source, Fnc<T, bool> predicate): Observable<T> {
  return new FilterObservable<T>(source, predicate);
}

pub fnc take<T>(Observable<T> source, int count): Observable<T> {
  return new TakeObservable<T>(source, count);
}


// Skip does not buffer or prefetch: it requests only enough items to satisfy
// the next downstream pull. Its remaining count belongs to this subscription.
define class SkipSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  let int remaining;

  constructor(Subscription<T> upstream, int count) {
    if count < 0; then
      val Result<bool, String> failure = Err("skip count must be nonnegative");
      failure.expect("rx.skip");
    fi
    self.upstream = upstream;
    self.remaining = count;
  }

  pub pull(mut self)(): Option<T> {
    loop {
      if self.remaining == 0; then
        return self.upstream.next();
      fi
      val Option<T> dropped = self.upstream.next();
      if dropped.is_none(); then
        self.remaining = 0;
        return None;
      fi
      self.remaining = self.remaining - 1;
    }
  }

  pub dispose(mut self)(): void {
    self.upstream.cancel();
    return;
  }
end

define class SkipObservable<T> extends Observable<T> as
  val Observable<T> source;
  val int count;

  constructor(Observable<T> source, int count) {
    if count < 0; then
      val Result<bool, String> failure = Err("skip count must be nonnegative");
      failure.expect("rx.skip");
    fi
    self.source = source;
    self.count = count;
  }

  pub subscribe(): Subscription<T> {
    return new SkipSubscription<T>(self.source.subscribe(), self.count);
  }
end

pub fnc skip<T>(Observable<T> source, int count): Observable<T> {
  return new SkipObservable<T>(source, count);
}

pub fnc first<T>(borrow Observable<T> source): Option<T> {
  let mut Subscription<T> sub = source.subscribe();
  try {
    return sub.next();
  } finally {
    sub.cancel();
  }
}

// Resource factories run once per subscription. Each Reader owns its callbacks.
pub define class Reader<T> as
  val Fnc<Option<T>> read_next;
  val Fnc<void> close;
  pub constructor(Fnc<Option<T>> read_next, Fnc<void> close) {
    self.read_next = read_next;
    self.close = close;
  }
  pub read(): Option<T> { return self.read_next(); }
  pub dispose(): void { self.close(); return; }
end

define class ReaderSubscription<T> extends Subscription<T> as
  val Reader<T> reader;
  constructor(Reader<T> reader) { self.reader = reader; }
  pub pull(mut self)(): Option<T> { return self.reader.read(); }
  pub dispose(mut self)(): void { self.reader.dispose(); return; }
end

define class ReaderObservable<T> extends Observable<T> as
  val Fnc<Reader<T>> open;
  constructor(Fnc<Reader<T>> open) { self.open = open; }
  pub subscribe(): Subscription<T> {
    return new ReaderSubscription<T>(self.open());
  }
end

pub fnc using<T>(Fnc<Reader<T>> open): Observable<T> {
  return new ReaderObservable<T>(open);
}
